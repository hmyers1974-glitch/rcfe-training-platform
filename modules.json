<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Module {{ m["id"] }} - {{ m["title"] }}</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #eef2f5;
            color: #222;
        }

        .container {
            width: 94%;
            max-width: 900px;
            margin: 20px auto;
        }

        .card {
            background: white;
            border-radius: 18px;
            padding: 22px;
            margin-bottom: 22px;
            box-shadow: 0 5px 18px rgba(0,0,0,.08);
        }

        a {
            color: #235c74;
            text-decoration: none;
            font-weight: bold;
        }

        h1 {
            margin-bottom: 8px;
        }

        h2 {
            margin-top: 5px;
        }

        .episode-label {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #667;
            font-weight: bold;
        }

        .scene {
            background: #182129;
            border-radius: 18px;
            overflow: hidden;
            margin-top: 20px;
            color: white;
        }

        .scene-header {
            padding: 15px 20px;
            background: #10171d;
            font-size: 14px;
            color: #d9e1e5;
        }

        .scene-body {
            padding: 22px;
        }

        .narrator {
            padding: 16px;
            margin-bottom: 20px;
            border-left: 4px solid #d7b56d;
            background: rgba(255,255,255,.08);
            border-radius: 8px;
            line-height: 1.6;
            font-style: italic;
        }

        .maria {
            text-align: center;
            margin: 25px 0;
        }

        .maria img {
            display: block;
            width: 200px;
            height: 200px;
            object-fit: cover;
            border-radius: 50%;
            border: 5px solid white;
            margin: 0 auto 12px auto;
            box-shadow: 0 8px 25px rgba(0,0,0,.4);
        }

        .name {
            font-size: 24px;
            font-weight: bold;
        }

        .role {
            font-size: 14px;
            opacity: .75;
            margin-top: 4px;
        }

        .speech {
            background: white;
            color: #222;
            padding: 18px;
            border-radius: 18px;
            margin: 16px 0;
            line-height: 1.6;
        }

        .speech strong {
            color: #235c74;
            font-size: 17px;
        }

        .decision {
            background: #f7f9fa;
            border: 2px solid #d9e1e5;
            border-radius: 16px;
            padding: 20px;
            margin-top: 22px;
        }

        .choice {
            display: block;
            width: 100%;
            margin: 12px 0;
            padding: 17px;
            border: 0;
            border-radius: 12px;
            background: #235c74;
            color: white;
            font-size: 16px;
            font-weight: bold;
            text-align: left;
        }

    </style>
</head>


<body>

<div class="container">

    <div class="card">

        <a href="/">
            ← Back to Dashboard
        </a>

        <h1>
            Module {{ m["id"] }}: {{ m["title"] }}
        </h1>

        {% if m.get("core") %}
        <p>
            <strong>{{ m["core"] }}</strong>
        </p>
        {% endif %}

        {% if m.get("minutes") %}
        <p>
            Estimated time: {{ m["minutes"] }} minutes
        </p>
        {% endif %}

    </div>


    {% if m["id"] == 1 %}


    <div class="card">

        <div class="episode-label">
            Episode 1
        </div>

        <h2>
            Resident Down
        </h2>

        <p>
            Your shift has just begun. What happens next depends on the
            decisions you make.
        </p>


        <div class="scene">

            <div class="scene-header">
                8:05 AM — Assisted Living
            </div>


            <div class="scene-body">

                <div class="narrator">
                    You have just started your morning when you hear quick
                    footsteps coming down the hallway.
                </div>


                <div class="maria">

                    <img
                        src="/static/static/maria-caregiver.png"
                        alt="Maria the caregiver"
                    >

                    <div class="name">
                        Maria
                    </div>

                    <div class="role">
                        Caregiver
                    </div>

                </div>


                <div class="speech">

                    <strong>Maria</strong>

                    <br><br>

                    “I need you in Room 108. I found Mrs. Thompson on the
                    floor next to her bed.”

                </div>


                <div class="narrator">
                    Maria looks worried. She waits for your direction.
                </div>


                <div class="speech">

                    <strong>You</strong>

                    <br><br>

                    “Is she awake?”

                </div>


                <div class="speech">

                    <strong>Maria</strong>

                    <br><br>

                    “Yes. She's talking to me, but she says her hip hurts.
                    I didn't move her.”

                </div>


                <div class="narrator">
                    You walk quickly with Maria to Room 108. Mrs. Thompson
                    is lying on the floor beside her bed.
                </div>

            </div>

        </div>


        <div class="decision">

            <h2>
                What do you do first?
            </h2>


            <button class="choice">
                A. Assess Mrs. Thompson for injuries before attempting to move her.
            </button>


            <button class="choice">
                B. Help Mrs. Thompson back into bed immediately.
            </button>


            <button class="choice">
                C. Ask Maria to finish getting the other residents ready first.
            </button>

        </div>

    </div>


    {% else %}


    <div class="card">

        <h2>
            {{ m["title"] }}
        </h2>

        <p>
            This module is ready for training content.
        </p>

    </div>


    {% endif %}


</div>

</body>

</html>
