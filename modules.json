<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Module {{ m["id"] }} - {{ m["title"] }}</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f3f4f6;
            color: #222;
        }

        .container {
            width: 92%;
            max-width: 900px;
            margin: 25px auto;
        }

        .card {
            background: white;
            border-radius: 16px;
            padding: 22px;
            margin-bottom: 22px;
            box-shadow: 0 4px 14px rgba(0,0,0,.08);
        }

        a {
            color: #235c74;
            text-decoration: none;
            font-weight: bold;
        }

        h1 {
            margin-top: 18px;
            color: #173f50;
        }

        h2 {
            color: #235c74;
        }

        h3 {
            margin-bottom: 10px;
        }

        .episode-label {
            color: #235c74;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .scene {
            background: #eef6f8;
            border-left: 5px solid #235c74;
        }

        .maria-area {
            text-align: center;
            margin-top: 20px;
        }

        .maria-image {
            width: 100%;
            max-width: 420px;
            height: auto;
            display: block;
            margin: 15px auto;
            border-radius: 18px;
            box-shadow: 0 6px 18px rgba(0,0,0,.15);
        }

        .dialogue {
            max-width: 650px;
            margin: 18px auto 0;
            background: white;
            padding: 18px;
            border-radius: 14px;
            border: 1px solid #d7e3e7;
            text-align: left;
            font-size: 18px;
            line-height: 1.55;
        }

        textarea {
            width: 100%;
            min-height: 130px;
            padding: 14px;
            border: 1px solid #bbb;
            border-radius: 10px;
            font-size: 16px;
            font-family: Arial, Helvetica, sans-serif;
        }

        button {
            margin-top: 12px;
            padding: 12px 18px;
            border: none;
            border-radius: 9px;
            background: #235c74;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #173f50;
        }

        .real-box {
            background: #f8fafb;
            border: 1px solid #d8e0e4;
            border-radius: 12px;
            padding: 16px;
            margin-top: 14px;
        }

        .coming-next {
            background: #fff9e8;
            border-left: 5px solid #d9a928;
        }

    </style>
</head>


<body>

<div class="container">

    <div class="card">

        <a href="/">← Back to Dashboard</a>

        <h1>
            Module {{ m["id"] }}:
            {{ m["title"] }}
        </h1>

        <p>
            <strong>{{ m.get("core", "") }}</strong>
        </p>

        {% if m.get("minutes") %}
        <p>
            Estimated time: {{ m["minutes"] }} minutes
        </p>
        {% endif %}

    </div>


    {% if m["id"] == 1 %}


    <div class="card">

        <h2>Administrator Mindset: Regulation to Real Life</h2>

        <p>
            Strong RCFE administration means recognizing risk,
            verifying the governing rule, acting within scope,
            documenting objectively, and fixing the system.
        </p>

        <div class="real-box">
            <strong>Use R.E.A.L.</strong>

            <p>
                <strong>R</strong> — Recognize
            </p>

            <p>
                <strong>E</strong> — Evaluate
            </p>

            <p>
                <strong>A</strong> — Act
            </p>

            <p>
                <strong>L</strong> — Learn & Lead
            </p>
        </div>

    </div>


    <div class="card scene">

        <div class="episode-label">
            Episode 1
        </div>

        <h2>Resident Down</h2>

        <p>
            It is 8:05 AM. You have just started your morning
            when a caregiver approaches you.
        </p>


        <div class="maria-area">

            <h3>Maria — Caregiver</h3>

            <img
                class="maria-image"
                src="{{ url_for('static', filename='maria-caregiver.png') }}"
                alt="Maria, caregiver"
            >

            <div class="dialogue">

                <strong>Maria:</strong>

                <p>
                    “Heather, I walked into Mrs. Smith's room
                    and observed her beside the bed on the floor.
                    She's awake, but I haven't moved her.
                    What do you want me to do?”
                </p>

            </div>

        </div>

    </div>


    <div class="card">

        <h2>Your Administrator Decision</h2>

        <p>
            You are the Administrator. Maria is waiting for your direction.
        </p>

        <p>
            What are your immediate priorities?
        </p>

        <textarea
            id="administratorResponse"
            placeholder="Type what you would do next..."
        ></textarea>

        <button onclick="saveResponse()">
            Save My Response
        </button>

        <p id="savedMessage"></p>

    </div>


    <div class="card">

        <h2>Think Like an Administrator</h2>

        <div class="real-box">

            <p>
                <strong>Recognize:</strong>
                A resident has been found on the floor.
                Immediate resident safety comes first.
            </p>

            <p>
                <strong>Evaluate:</strong>
                Determine the resident's condition,
                circumstances surrounding the event,
                and whether emergency assistance is needed.
            </p>

            <p>
                <strong>Act:</strong>
                Follow facility policy and the resident's
                emergency and care plan while ensuring
                appropriate assessment, notification,
                documentation, and follow-up.
            </p>

            <p>
                <strong>Learn & Lead:</strong>
                After the immediate situation is stabilized,
                identify contributing factors and determine
                what interventions may prevent another occurrence.
            </p>

        </div>

    </div>


    <div class="card">

        <h2>Regulation Hunt</h2>

        <p>
            Locate the current California RCFE regulation or topic
            that addresses Administrator responsibility.
        </p>

        <p>
            Enter the section or topic and one sentence describing
            what it requires.
        </p>

        <textarea
            id="regulationResponse"
            placeholder="Enter the regulation/topic and what it requires..."
        ></textarea>

        <button onclick="saveRegulation()">
            Save Progress
        </button>

        <p id="regulationSaved"></p>

    </div>


    <div class="card coming-next">

        <div class="episode-label">
            Coming Next
        </div>

        <h2>Episode 2</h2>

        <p>
            The immediate emergency is only the beginning.
            Next, you will decide what must be documented,
            who must be notified, and what the Administrator
            must do to prevent the incident from happening again.
        </p>

    </div>


    {% else %}


    <div class="card">

        <h2>Lesson</h2>

        <p>
            {{ m.get("lesson", "Module content coming soon.") }}
        </p>

    </div>


    {% endif %}


</div>


<script>

function saveResponse() {

    const response =
        document.getElementById("administratorResponse").value;

    localStorage.setItem(
        "module1_administrator_response",
        response
    );

    document.getElementById("savedMessage").innerText =
        "✓ Response saved on this device.";
}


function saveRegulation() {

    const response =
        document.getElementById("regulationResponse").value;

    localStorage.setItem(
        "module1_regulation_response",
        response
    );

    document.getElementById("regulationSaved").innerText =
        "✓ Progress saved on this device.";
}


window.onload = function() {

    const savedResponse =
        localStorage.getItem("module1_administrator_response");

    const savedRegulation =
        localStorage.getItem("module1_regulation_response");


    if (
        savedResponse &&
        document.getElementById("administratorResponse")
    ) {
        document.getElementById(
            "administratorResponse"
        ).value = savedResponse;
    }


    if (
        savedRegulation &&
        document.getElementById("regulationResponse")
    ) {
        document.getElementById(
            "regulationResponse"
        ).value = savedRegulation;
    }

};

</script>


</body>
</html>
